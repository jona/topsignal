{
  "name": "topsignal",
  "version": "0.3.0",
  "description": "Collect developer profile evidence for an agent harness and publish the completed profile",
  "license": "MIT",
  "type": "module",
  "bin": {
    "topsignal": "dist/entrypoints/cli/index.js"
  },
  "files": [
    "dist",
    "HARNESS.md",
    "prompts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test",
    "start": "node dist/entrypoints/cli/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "dotenv": "^17.3.1",
    "ink": "^6.8.0",
    "ora": "^9.3.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "prettier": "^3.8.1",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jona/topsignal.git"
  },
  "homepage": "https://www.topsignal.dev",
  "bugs": {
    "url": "https://github.com/jona/topsignal/issues"
  }
}
